msgstr "部分失败"

msgid "Recursion Depth"
msgstr "递归深度"

msgid "Trigger Queue Row"
msgstr "触发器队列表行"

msgid "Error Summary"
msgstr "错误摘要"

msgid "Snapshot"
msgstr "快照"

msgid "Actions Snapshot"
msgstr "操作快照"

msgid ""
"The flow's steps as they were when the run started. A resumed run "
