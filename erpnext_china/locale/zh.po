msgstr "销售发票总额"

msgid "Total Incoming Bills"
msgstr "采购发票总额"

msgid "Total Incoming Payment"
msgstr "收款总额"

msgid "Budgeting"
msgstr "预算"

msgid "Total Outgoing Payment"
msgstr "付款总额"

msgid "Banking Setup"
msgstr "银行设置"

msgid "Outgoing Bills (Sales Invoice)"
msgstr "销售发票（应收）"

msgid "Quality Reports"
msgstr "质量报表"

msgid "Open Quality Actions"
msgstr "未完成的质量措施"

msgid "Open Non Conformances"
msgstr "未完成的不合格项"

msgid "Open Quality Reviews"
msgstr "未完成的质量评审"

msgid "Average Sales Order Value"
msgstr "销售订单平均金额"

msgid "Sales Orders Count"
msgstr "销售订单数"

msgid "Warehouse wise Stock Value"
msgstr "按仓库的库存金额"

msgid "Location-wise Asset Value"
msgstr "按位置的资产金额"

msgid "Territory Wise Sales"
msgstr "按区域销售额"

msgid "Accounts Receivable Ageing"
msgstr "应收账款账龄"

msgid "Incoming Bills (Purchase Invoice)"
msgstr "采购发票（应付）"

msgid "Accounts Payable Ageing"
msgstr "应付账款账龄"

msgid ""
"A published list of codes, like units or tax categories, used in "
"e-invoicing."
msgstr "电子发票使用的标准代码清单，例如单位或税种分类。"

msgid "A code from a code list and what it maps to."
msgstr "代码清单中的某个代码及其对应关系。"

msgid "A customer's confirmed order."
msgstr "客户已确认的订单。"

msgid "Sells several items together as one item."
msgstr "将多个物料打包成一个物料销售。"

msgid "A company or person you sell goods or services to."
msgstr "你销售商品或服务的对象（企业或个人）。"

msgid "How quotations, sales orders and pricing work."
msgstr "报价、销售订单与定价的工作方式。"

msgid "Prices you offer a customer or lead."
msgstr "你向客户或线索提供的报价。"

msgid "Ask suppliers for prices on the items you need."
msgstr "向供应商索取所需物料的价格。"

msgid "A band of scores, and what happens to suppliers in it."
msgstr "一个得分区间，以及落在该区间供应商的处理方式。"

msgid "Something a supplier is scored on, like on-time delivery."
msgstr "供应商被评分的项目，例如按时交货。"

msgid "Prices a supplier offered you."
msgstr "供应商提供给你的价格。"

msgid "A value a scorecard criterion is calculated from."
msgstr "计算评分卡标准所依据的数值。"

msgid "A company or person you buy goods or services from."
msgstr "你采购商品或服务的对象（企业或个人）。"

msgid "Rates a supplier over time on criteria you choose."
msgstr "按你设定的标准对供应商进行长期评分。"

msgid "An order you place with a supplier."
msgstr "你向供应商下达的订单。"

msgid "A kind of workstation, with its costs."
msgstr "一种工作站类型及其成本。"

msgid "An order to make a quantity of an item."
msgstr "生产一定数量物料的订单。"

msgid "An agreement to buy or sell an item at a fixed price over a period."
msgstr "在一段时间内以固定价格买卖物料的协议。"

msgid "A step in making an item, like cutting or assembly."
msgstr "制造物料的一道工序，例如切割或装配。"

msgid "Build a multi-level BOM in one place."
msgstr "在一个界面中构建多层物料清单。"

msgid "A view of your workstations and what each is doing."
msgstr "查看各工作站及其当前任务。"

msgid "The order of operations to make an item."
msgstr "制造物料的工序顺序。"

msgid "How much you expect to sell, to plan production."
msgstr "预计销量，用于安排生产。"

msgid "The materials and operations it takes to make an item."
msgstr "制造物料所需的材料与工序。"

msgid "The work done for one operation of a work order."
msgstr "工单中某一工序完成的工作。"

msgid "A machine or place where operations are done."
msgstr "执行工序的机器或场所。"

msgid "The progress of a BOM replacement or cost update."
msgstr "物料清单替换或成本更新的进度。"

msgid "How much of each item to make, and when."
msgstr "每种物料的生产数量与时间。"

msgid "Time a workstation stood idle, and why."
msgstr "工作站停机时长及原因。"

msgid "Plans the work orders and materials needed for your demand."
msgstr "根据需求规划所需的工单与物料。"

msgid "Replace a BOM everywhere it is used, or update the cost of all BOMs."
msgstr "替换所有使用到的物料清单，或更新全部物料清单的成本。"

msgid "A grouping of projects, like internal or external."
msgstr "项目的分类，例如内部项目或外部项目。"

msgid "A kind of work you track time against, like design or support."
msgstr "记录工时的活动类型，例如设计或支持。"

msgid "A grouping of tasks, like bug or feature."
msgstr "任务的分类，例如缺陷或功能。"

msgid "A set of tasks to start new projects from."
msgstr "用于快速启动新项目的任务集合。"

msgid "Time spent on tasks and activities, to bill or cost."
msgstr "在任务与活动上花费的时间，用于计费或成本核算。"

msgid "What an employee costs and bills per hour for an activity."
msgstr "员工在某活动上的每小时成本与收费。"

msgid "A piece of work to be done, often part of a project."
msgstr "一项待办工作，通常属于某个项目。"

msgid "A piece of work with tasks, time and costs."
msgstr "包含任务、工时和成本的一项工作。"

msgid "A progress update collected from the project team."
msgstr "项目团队提交的进度更新。"

msgid "A grouping of issues, like billing or technical."
msgstr "问题的分类，例如计费或技术。"

msgid "How fast issues must be answered and resolved."
msgstr "问题必须响应和解决的速度要求。"

msgid "A customer's claim to repair or replace an item under warranty."
msgstr "客户提出的保修维修或更换申请。"

msgid "A problem or question raised by a customer."
msgstr "客户提出的问题或咨询。"

msgid "How urgent an issue is."
msgstr "问题的紧急程度。"

msgid "Which warehouse received items go to."
msgstr "收货进入哪个仓库。"

msgid "A property item variants differ by, like size or colour."
msgstr "物料变体之间的差异属性，例如尺寸或颜色。"

msgid "How items, warehouses and stock transactions work."
msgstr "物料、仓库与库存业务的工作方式。"

msgid "A set of item prices for buying, selling or both."
msgstr "用于采购、销售或两者共用的物料价格表。"

msgid "A grouping of warehouses, like transit or store."
msgstr "仓库的分类，例如在途仓或存储仓。"

msgid "An extra way to tag stock, like a rack or bin."
msgstr "库存的额外标记维度，例如货架或储位。"

msgid "A place where you keep stock."
msgstr "存放库存的地点。"

msgid "Adds freight, duty and other charges to the cost of received items."
msgstr "把运费、关税和其他费用计入所收物料的成本。"

msgid "The contents and weight of each package in a delivery."
msgstr "每次发货中各包装的内容与重量。"

msgid "A company that makes the items you buy or sell."
msgstr "生产你所买卖物料的企业。"

msgid "The items and quantities to pick from the warehouse."
msgstr "需要从仓库拣出的物料与数量。"

msgid "Moves, receives, issues or manufactures stock."
msgstr "库存的调拨、收货、发料或生产。"

msgid "A request to buy, transfer or make items."
msgstr "采购、调拨或生产物料的申请。"

msgid "A vehicle's route to deliver to several customers."
msgstr "向多个客户送货的车辆路线。"

msgid "Something an item is checked for, like weight or colour."
msgstr "物料需要检查的项目，例如重量或颜色。"

msgid "Stock set aside for a sales order or production."
msgstr "为销售订单或生产预留的库存。"

msgid "An item you can use in place of another."
msgstr "可替代另一种物料使用的物料。"

msgid "The parameters to check an item for."
msgstr "物料需要检查的参数。"

msgid "A parcel you send through a carrier."
msgstr "通过承运商寄送的包裹。"

msgid "The serial numbers and batches moved in a transaction."
msgstr "一笔业务中流转的序列号与批号。"

msgid "Items received from a supplier."
msgstr "从供应商收到的物料。"

msgid "A kind of stock entry, like material transfer or manufacture."
msgstr "一种库存移动类型，例如物料调拨或生产入库。"

msgid "Sets stock quantities and values to what is actually in your warehouses."
msgstr "把库存数量与金额调整为仓库的实际数。"

msgid "A grouping of inspection parameters."
msgstr "检查参数的分组。"

msgid "Items shipped to a customer."
msgstr "发给客户的物料。"

msgid "The price of an item in a price list."
msgstr "价格表中物料的价格。"

msgid "Checks an item against its quality parameters."
msgstr "按质量参数检查物料。"

msgid "How long it takes to get or make an item."
msgstr "采购或生产某物料所需的时间。"

msgid "Closes stock balances for a period so reports run faster."
msgstr "关闭某期间的库存余额，以加快报表运行。"

msgid "A group of units of an item made or received together."
msgstr "一起生产或收货的一批物料单位。"

msgid "The tariff code an item is declared under at customs."
msgstr "物料报关时使用的税则号。"

msgid "A parcel size you ship often."
msgstr "常用的包裹规格。"

msgid "Recalculates stock values after a backdated change."
msgstr "补录历史业务后重新计算库存金额。"

msgid "A product or service you buy, sell or keep in stock."
msgstr "你采购、销售或库存管理的产品或服务。"

msgid "A grouping of units, like weight or length."
msgstr "计量单位的分组，例如重量或长度。"

msgid "A single unit of an item, tracked by its own number."
msgstr "按自身编号追踪的单个物料单位。"

msgid "A visit to service or repair what a customer bought."
msgstr "上门服务或维修客户所购产品。"

msgid "Planned visits to service what a customer bought."
msgstr "为客户所购产品安排的服务计划。"

msgid "A brand your items are sold under."
msgstr "物料销售所用的品牌。"

msgid "A distributor, dealer or reseller who sells for you on commission."
msgstr "按佣金为你代销的分销商、经销商或代理商。"

msgid "A department of your company."
msgstr "公司的部门。"

msgid "Standard terms to add to quotes, orders and invoices."
msgstr "可添加到报价单、订单和发票的标准条款。"

msgid "Someone who sells for you, with targets and commission."
msgstr "为你销售并承担指标与佣金的人员。"

msgid "Groups suppliers, for terms and reporting."
msgstr "对供应商分组，便于设置条款和统计报表。"

msgid "Groups customers, for pricing and reporting."
msgstr "对客户分组，便于定价和统计报表。"

msgid "The rate to convert one currency into another."
msgstr "一种货币兑换为另一种货币的汇率。"

msgid "A regular email summing up how the business is doing."
msgstr "定期汇总经营情况的邮件。"

msgid "A branch of your company."
msgstr "公司的分支机构。"

msgid "Deletes a company's transactions, keeping its masters."
msgstr "删除公司的业务单据，保留其主数据。"

msgid "A legal entity with its own books, like your business or a subsidiary."
msgstr "独立建账的法律主体，例如你的公司或子公司。"

msgid "A unit you measure items in, like kg or box."
msgstr "物料的计量单位，例如千克或箱。"

msgid "Groups items, for pricing, defaults and reporting."
msgstr "对物料分组，便于定价、设置默认值和统计报表。"

msgid "A job title, like manager or accountant."
msgstr "职位名称，例如经理或会计。"

msgid "The holidays and weekly offs of a company or employee."
msgstr "公司或员工的节假日与每周休息日。"

msgid "Requires approval for transactions above a limit."
msgstr "超过限额的单据需要审批。"

msgid "How many of one unit make another, like 1000 g in a kg."
msgstr "一个单位等于多少另一个单位，例如 1 千克 = 1000 克。"

msgid "A region you sell in, to group customers and set targets."
msgstr "销售区域，用于对客户分组和设定指标。"

msgid "An order for a subcontractor to make items from your materials."
msgstr "委托外协厂商用你的物料加工物料的订单。"

msgid "An order to make items for a customer from materials they send."
msgstr "用客户提供的物料为其加工物料的订单。"

msgid "Items received from a subcontractor."
msgstr "从外协厂商收到的物料。"

msgid "The materials a subcontractor uses to make an item for you."
msgstr "外协厂商为你加工物料所使用的材料。"

msgid "Groups assets that share accounts and depreciation rules."
msgstr "把使用相同科目和折旧规则的资产分组。"

msgid "A repair made to an asset, and what it cost."
msgstr "资产的维修记录及其费用。"

msgid "The people responsible for maintaining assets."
msgstr "负责资产维护的人员。"

msgid "How much faster an asset depreciates on a given shift."
msgstr "某班次下资产折旧的加速倍数。"

msgid "Changes how many shifts an asset works, which changes its depreciation."
msgstr "变更资产的工作班次，从而影响折旧。"

msgid "When an asset depreciates, and by how much."
msgstr "资产的折旧时间与折旧金额。"

msgid "A place where your assets are kept."
msgstr "资产存放的地点。"

msgid "Moves an asset to another location or person."
msgstr "把资产移到其他地点或交给其他人。"

msgid "Changes an asset's value outside its depreciation."
msgstr "在折旧之外调整资产价值。"

msgid "A record of maintenance done on an asset."
msgstr "资产已完成的维护记录。"

msgid "Turns stock items or services into an asset, or one asset into another."
msgstr "把库存物料或服务转为资产，或将一项资产转为另一项。"

msgid "The upkeep tasks an asset needs, and who does them."
msgstr "资产需要的维护任务及负责人。"

msgid ""
"Something your business owns and uses over time, like a machine or a "
"laptop."
msgstr "企业长期拥有并使用的物品，例如机器或笔记本电脑。"

msgid "A channel customers reach you on, like a phone line."
msgstr "客户联系你的渠道，例如电话线路。"

msgid "A meeting booked with a lead or customer."
msgstr "与线索或客户约定的会面。"

msgid "A series of emails sent to leads or contacts on a schedule."
msgstr "按计划向线索或联系人发送的系列邮件。"

msgid "A company you are trying to win as a customer, with its leads."
msgstr "正在争取成为客户的公司及其线索。"

msgid "A marketing campaign, to see which leads and sales it brought in."
msgstr "营销活动，用于查看它带来的线索与销售。"

msgid "A potential sale to a lead or customer."
msgstr "面向线索或客户的潜在销售机会。"

msgid "An agreement with a customer, supplier or employee."
msgstr "与客户、供应商或员工签订的协议。"

msgid "A step in your sales process, like qualification or negotiation."
msgstr "销售流程中的一个阶段，例如资格审核或商务谈判。"

msgid "How leads, opportunities and appointments work."
msgstr "线索、商机与约见的工作方式。"

msgid "Someone who might buy from you."
msgstr "有可能向你购买的人。"

msgid "A phone call made or received."
msgstr "呼出或接听的电话。"

msgid "A grouping of calls, like sales or support."
msgstr "电话的分类，例如销售或支持。"

msgid "Your calling preferences, like when you take calls."
msgstr "通话偏好设置，例如接听时间。"

msgid "Who answers incoming calls, and when."
msgstr "谁在什么时候接听来电。"

msgid "A certificate that lets you withhold less tax from a supplier."
msgstr "可向供应商少代扣税款的证书。"

msgid "The VAT accounts to report in the South Africa VAT audit report."
msgstr "南非增值税审计报表中使用的增值税科目。"

msgid "Closes a POS shift and totals what was collected."
msgstr "结束销售点班次并统计收款金额。"

msgid "A direct entry in your books, for anything without its own form."
msgstr "账簿中的直接分录，用于没有专门单据的业务。"

msgid "Bring in your chart of accounts from a spreadsheet."
msgstr "从电子表格导入科目表。"

msgid "Rebuilds the ledger entries of transactions that were posted wrongly."
msgstr "重新生成记账有误业务的分录。"

msgid "A code customers enter to get a discount from a pricing rule."
msgstr "客户输入的优惠码，用于触发定价规则的折扣。"

msgid "How much a cost center or project may spend over a fiscal year."
msgstr "成本中心或项目在一个财年内可支出的额度。"

msgid "Rebuilds the payment ledger so outstanding amounts are right again."
msgstr "重建收付款台账，使未结金额恢复正确。"

msgid "Combine two or more accounts into one."
msgstr "将两个或多个科目合并为一个。"

msgid "A batch of payments to send to your bank."
msgstr "提交给银行的一批付款。"

msgid "Ask a customer to pay, by email with a payment link."
msgstr "通过带付款链接的邮件请客户付款。"

msgid "Undo a payment's match against invoices."
msgstr "取消付款与发票的核销。"

msgid "A set of discounts and free items, like buy two get one free."
msgstr "一组折扣与赠品，例如买二送一。"

msgid ""
"Settings for a point of sale, like its warehouse, price list and payment "
"methods."
msgstr "销售点的设置，例如仓库、价格表和付款方式。"

msgid "A record of shares issued, bought back or moved between shareholders."
msgstr "股份发行、回购或在股东之间转让的记录。"

msgid "Splits one cost center's amounts across others by percentage."
msgstr "按百分比把一个成本中心的金额分摊到其他成本中心。"

msgid "Shows which POS invoices were merged into a sales invoice."
msgstr "显示哪些销售点发票已并入销售发票。"

msgid "Works out the shipping charge on a sale or purchase."
msgstr "计算销售或采购的运费。"

msgid "The taxes and charges, like shipping or insurance, to add to purchases."
msgstr "采购需要加计的税费，例如运费或保险费。"

msgid "Closes a fiscal year by moving its profit or loss to equity."
msgstr "把财年损益结转至权益以关闭财年。"

msgid "A saved set of accounts to start journal entries from."
msgstr "预先保存的科目组合，用于快速录入日记账凭证。"

msgid "A line from your bank statement, ready to be matched with a payment."
msgstr "银行对账单中的一行，可与收付款核销。"

msgid "Raise money against unpaid sales invoices."
msgstr "以未收款的销售发票融资。"

msgid "Restates foreign currency balances at today's exchange rate."
msgstr "按当日汇率重估外币余额。"

msgid "Rewards customers with points they can spend on later purchases."
msgstr "向客户赠送积分，供后续消费使用。"

msgid "A set of payment terms to apply to invoices and orders."
msgstr "应用于发票和订单的一组付款条件。"

msgid "A bill from a supplier for what you bought."
msgstr "供应商就你所采购货物开来的账单。"

msgid "Tax rates for items that are taxed differently from the rest."
msgstr "与其他物料适用不同税率的物料税率。"

msgid "A person or company that owns shares in your company."
msgstr "持有你公司股份的个人或企业。"

msgid "A way you pay or get paid, like cash, bank transfer or card."
msgstr "收付款方式，例如现金、银行转账或银行卡。"

msgid "Matches payments to invoices in the background."
msgstr "在后台把付款与发票核销。"

msgid "Bills a customer or supplier for the same things on a schedule."
msgstr "按周期就相同内容向客户或供应商开票。"

msgid "A sale made at the point of sale."
msgstr "在销售点完成的销售。"

msgid "What a subscription bills for, and at what price."
msgstr "订阅的计费内容与价格。"

msgid "Groups accounts into the lines your financial statements show."
msgstr "把科目归集为财务报表上的各个项目。"

msgid "Bring in a bank statement to match its lines against your books."
msgstr "导入银行对账单，将其明细与账面核对。"

msgid "A bank you or your customers and suppliers hold accounts with."
msgstr "你或你的客户、供应商开户的银行。"

msgid "Points a customer earned or spent under a loyalty program."
msgstr "客户在积分计划中获得或使用的积分。"

msgid ""
"A part of your business you track income and expenses for, like a branch "
"or product line."
msgstr "需要单独核算收支的业务单元，例如分支或产品线。"

msgid "The wording and fee for a kind of payment reminder."
msgstr "某种催款提醒的措辞与费用。"

msgid ""
"A separate set of books, for example to depreciate assets under another "
"rule."
msgstr "独立的一套账簿，例如按另一规则计提资产折旧。"

msgid "Picks the right tax template for a customer, supplier or address."
msgstr "为客户、供应商或地址自动匹配合适的税率模板。"

msgid "A reminder to a customer about an overdue invoice."
msgstr "向客户发出的逾期发票提醒。"

msgid "A grouping of bank accounts, like checking or credit card."
msgstr "银行账户的分类，例如支票账户或信用卡账户。"

msgid "Opens a POS shift with the cash in the drawer."
msgstr "以钱箱中的现金开始销售点班次。"

msgid "Money you received or paid, matched against invoices."
msgstr "已收或已付并与发票核销的款项。"

msgid "The rows and formulas of a custom financial statement."
msgstr "自定义财务报表的项目行与公式。"

msgid "A group of tax withholding categories that apply together."
msgstr "需要同时适用的一组代扣税类别。"

msgid "The year your books are kept and closed for."
msgstr "账簿记账与结账的年度。"

msgid "Emails customers their statements on a schedule."
msgstr "按周期向客户发送对账单邮件。"

msgid "A ledger in your chart of accounts that entries are posted to."
msgstr "科目表中用于记账的明细账簿。"

msgid "An extra way to tag entries, like branch or region, beyond cost centers."
msgstr "除成本中心外的额外记账维度，例如分支或区域。"

msgid "A guarantee a bank gives on your behalf, or on a customer's or supplier's."
msgstr "银行为你或你的客户、供应商提供的担保。"

msgid "A class of shares, like equity or preference."
msgstr "股份的类别，例如普通股或优先股。"

msgid "Spreads a yearly budget or target across months for seasonal businesses."
msgstr "把年度预算或目标按月分摊，适用于季节性业务。"

#, python-format
msgid "When part of an invoice is due, like 50% in 30 days."
msgstr "发票的分期到期安排，例如 30 天内支付 50%。"

msgid "A date range you can close so no one posts into it."
msgstr "可以关闭的日期区间，关闭后不允许再记账。"

msgid "A bank account of yours or of a customer or supplier."
msgstr "你或你的客户、供应商的银行账户。"

msgid "Rates and thresholds for tax withheld on payments, like TDS."
msgstr "付款代扣税的税率与起征点，例如 TDS。"

msgid "The taxes and charges, like shipping or insurance, to add to sales."
msgstr "销售需要加计的税费，例如运费或保险费。"

msgid "Changes a price or gives a discount when its conditions are met."
msgstr "满足条件时调整价格或给予折扣。"

msgid "A bill to a customer for what you sold."
msgstr "就所售商品向客户开立的账单。"

msgid "Where each detail goes when you print on your bank's cheque."
msgstr "使用银行支票打印时各项内容的打印位置。"

msgid "A finer grouping of bank accounts, like savings or current."
msgstr "银行账户的细分类型，例如储蓄账户或往来账户。"

msgid "Books deferred revenue or expense for a period."
msgstr "按期确认递延收入或递延费用。"

msgid "Applies a tax template automatically when its conditions match."
msgstr "条件匹配时自动应用税率模板。"

msgid "The result of creating or submitting many documents at once."
msgstr "批量创建或提交多个单据的结果。"

msgid "What you did to fix or prevent a quality problem."
msgstr "为解决或预防质量问题所采取的措施。"

msgid "Something that did not meet your quality standard."
msgstr "未达到质量标准的事项。"

msgid "Feedback on your quality from a customer or employee."
msgstr "客户或员工对质量的反馈。"

msgid "The steps of a process you follow to keep quality in check."
msgstr "为保证质量所遵循的流程步骤。"

msgid "The questions to ask when collecting quality feedback."
msgstr "收集质量反馈时要询问的问题。"

msgid "A meeting to review quality, with its agenda and minutes."
msgstr "评审质量的会议，含议程与会议纪要。"

msgid "A periodic check of how a quality goal is going."
msgstr "对质量目标进展的定期检查。"

msgid "Something you measure and improve on a schedule, like on-time delivery."
msgstr "按周期衡量并改进的事项，例如按时交货率。"

msgid "Fix issues"
msgstr "修复问题"

msgid "Sr. No"
msgstr "序号"

msgid ".csv, .xlsx up to {0} MB"
msgstr ".csv、.xlsx，最大 {0} MB"

