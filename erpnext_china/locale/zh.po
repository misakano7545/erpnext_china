"<li>frappe.session</li>\r\n"
"<li>frappe.utils.now_datetime</li>\r\n"
"<li>frappe.utils.get_datetime</li>\r\n"
"<li>frappe.utils.add_too_date</li>\r\n"
"<li>frappe.utils.now</li>\r\n"
"</ul>\r\n"
