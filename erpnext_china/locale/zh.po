"    <li><b>Body</b>: <br><br>\r\n"
"<pre><code>Hello {{ customer.customer_name }},<br>PFA your Statement Of "
"Accounts from {{ doc.from_date }} to {{ doc.to_date }}.</code> "
"</pre></li>\r\n"
"</ul>\r\n"
"<!-- {% endraw %} -->"
